# OpenHotspot daemon with a tray icon (needs `pip install 'openhotspot[tray]'` and a graphical
# session). Replaces openhotspot.service; install.sh --tray enables this one instead.
[Unit]
Description=OpenHotspot with tray icon: turn on the paired phone's hotspot when this laptop is offline
After=graphical-session.target
PartOf=graphical-session.target
Conflicts=openhotspot.service

[Service]
Type=simple
ExecStart=%h/.local/bin/openhotspot daemon --tray
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Nice=10
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
